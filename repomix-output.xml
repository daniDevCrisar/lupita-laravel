-- ---------------------------------------------------------------------
-- 3) PERMISOS QUE DEJAN DE EXISTIR
--    Las asignaciones se van solas por ON DELETE CASCADE.
-- ---------------------------------------------------------------------
-- 3.1 Los 3 permisos de API (ya no controlan nada)
DELETE FROM `permissions`
WHERE `name` IN (
    'ver documentacion api',
