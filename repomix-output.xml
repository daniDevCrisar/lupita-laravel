    public static function puntaje_conductor($item)
    {
        $iconos= self::$etiquetas_icon_bi;
        $count=0;
        $fallidas= $item->fallidas-$item->total_error??0;
        foreach ($iconos as $key => $value) { //buscar por clave de icono
