            }
            if($t_fallo < $t_min_f) {
                $t_min_f = $t_fallo;$hora_min_f = $i;
            }
            if($t_exito < $t_min_e) {
                $t_min_e = $t_exito;$hora_min_e = $i;
            }
        }
        $resumen_mapa->max_total=$t_max_t;
