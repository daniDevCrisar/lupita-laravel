            $id_trt= ($id_trt !== 'null' && $id_trt !== '') ? $id_trt : null;
        }
        else
            $id_trt= null;

        $sql="
        INSERT INTO referencias (
            ref, trt_id, conductor_id, fecha_despachador,
            titulo_viaje, placa, fin_descargue, inicio_descargue,
            qr_llegada_destino,
            inicio_ruta,
