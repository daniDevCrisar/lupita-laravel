    ('gestionar casos conductores',            'web', NOW(), NOW()),
    -- SENSIBLES
    ('eliminar lote',                         'web', NOW(), NOW()),
    ('fusionar conductores',                  'web', NOW(), NOW()),
    ('administrar usuarios',                  'web', NOW(), NOW()),
    -- HEREDADOS
